{
  "name": "mediaflow-studio",
  "version": "3.0.0",
  "description": "MediaFlow Studio — a polished media toolkit for video editors: convert, download, trim and extract audio.",
  "main": "src/main.js",
  "scripts": {
    "test": "node --test test/",
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "author": "Noxuu58",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "MediaFlow Studio",
  "build": {
    "appId": "com.mediaflow.studio",
    "files": [
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "MediaFlow-Studio-${version}-portable.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [
    "ffmpeg",
    "yt-dlp",
    "electron",
    "video-editing",
    "media-converter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Noxuu58/mediaflow-studio.git"
  },
  "homepage": "https://github.com/Noxuu58/mediaflow-studio"
}
