{
  "name": "mediaflow-studio",
  "version": "1.0.0",
  "description": "MediaFlow Studio — a polished media toolkit for video editors: convert, download, trim and extract audio.",
  "main": "src/main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "fetch-ytdlp": "node scripts/fetch-ytdlp.js",
    "dist": "node scripts/fetch-ytdlp.js && electron-builder --win --publish never"
  },
  "author": "Noxuu58",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "MediaFlow Studio",
  "build": {
    "appId": "com.mediaflow.studio",
    "files": [
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "extraResources": [
      {
        "from": "vendor/yt-dlp.exe",
        "to": "bin/yt-dlp.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MediaFlow Studio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "artifactName": "MediaFlow-Studio-Setup.exe"
    },
    "portable": {
      "artifactName": "MediaFlow-Studio-Portable.exe"
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Noxuu58",
        "repo": "mediaflow-studio"
      }
    ]
  },
  "keywords": [
    "ffmpeg",
    "yt-dlp",
    "electron",
    "video-editing",
    "media-converter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Noxuu58/mediaflow-studio.git"
  },
  "homepage": "https://github.com/Noxuu58/mediaflow-studio"
}
